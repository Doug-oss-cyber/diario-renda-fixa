# Copie este arquivo para .env e preencha. Nunca faça commit do .env.

# Chave de acesso do provedor (segredo)
LLM_API_KEY=

# Endereço base da API (veja a documentação do provedor ou o Moodle)
LLM_BASE_URL=

# Nome do modelo
LLM_MODEL=

# Parâmetros opcionais
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SEGUNDOS=120