# Copie este arquivo para .env e preencha. Nunca faça commit do .env.

# --- Acesso ao LLM ---
# Servidor Ollama interno da plataforma Devel Lab (acessível só de dentro do container).
# Para testar com um Ollama local: LLM_BASE_URL=http://localhost:11434
LLM_BASE_URL=https://llm-internal.softex:9001
LLM_MODEL=qwen3.5:9b-q4_K_M

# --- Credencial (opcional) ---
# O Ollama interno não exige credencial. Se o servidor passar a exigir, preencha.
# É um segredo: nunca versione o .env.
LLM_API_KEY=

# --- Parâmetros de geração e tempos (segundos) ---
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SEGUNDOS=120
LLM_ESPERA_PRONTIDAO_SEGUNDOS=180

# --- Certificado HTTPS (padrão: verificar) ---
# Desativar só como teste temporário contra o servidor interno, com dados fictícios.
LLM_VERIFICAR_SSL=true
# LLM_CA_BUNDLE=certs/softex.pem

# --- Registro de execução (opcional) ---
# O console sempre registra; defina para gravar também em arquivo (só metadados).
# LOG_ARQUIVO=logs/diario.log

# --- Uso em container (defina no dashboard, não aqui) ---
# DIARIO_ANOTACAO=Tirei 1500 do CDB de liquidez diaria do Nubank